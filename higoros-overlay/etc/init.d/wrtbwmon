#!/bin/sh /etc/rc.common
# Copyright (C) 2019 OpenWrt.org

START=99
USE_PROCD=1

NAME=wrtbwmon
PID_FILE=/var/run/wrtbwmon.pid

create_instance() {
	local db="$1"
	local interval="$2"

	procd_open_instance
	procd_set_param command /usr/sbin/wrtbwmon -46 -f "$db" -p /tmp/usage.htm -u /etc/wrtbwmon.user -s "$interval" -d
	procd_set_param respawn
	procd_set_param user root
	procd_close_instance
}

service_triggers()
{
	procd_add_reload_trigger "$NAME"
}

start_service() {
	local db enabled interval
	local pid
	config_load $NAME

	config_get db general path
	[ -z "$db" ] && db="/tmp/usage.db"
	config_get interval general interval
	[ -z "$interval" ] && interval="5"

	# Clean up stale runtime artifacts that can make wrtbwmon exit immediately.
	if [ -f "$PID_FILE" ]; then
		pid="$(cat "$PID_FILE" 2>/dev/null)"
		if [ -z "$pid" ] || [ ! -d "/proc/$pid" ] || ! grep -qa wrtbwmon "/proc/$pid/cmdline" 2>/dev/null; then
			rm -f "$PID_FILE"
		fi
	fi
	[ -f /var/lock/wrtbwmon.lock ] && [ ! -f "$PID_FILE" ] && rm -f /var/lock/wrtbwmon.lock

	config_get enabled  general enabled
	[ "$enabled"0 -eq 0 ] || create_instance "$db" "$interval"
}

stop_service() {
	procd_kill wrtbwmon
	[ -f "$PID_FILE" ] && kill "$(cat "$PID_FILE")" >/dev/null 2>&1
	local pids="$(ps | grep '/usr/sbin/wrtbwmon -' | grep -v grep | awk '{print $1}')"
	[ -n "$pids" ] && kill $pids >/dev/null 2>&1
	sleep 1
	pids="$(ps | grep '/usr/sbin/wrtbwmon -' | grep -v grep | awk '{print $1}')"
	[ -n "$pids" ] && kill -9 $pids >/dev/null 2>&1
	rm -f "$PID_FILE"
}
