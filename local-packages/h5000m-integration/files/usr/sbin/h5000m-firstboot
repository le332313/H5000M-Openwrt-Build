#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# h5000m-firstboot — product defaults that make a freshly flashed H5000M usable
# without logging in first.
#
# Called from three places, all of which funnel into the same idempotent code:
#
#   /etc/uci-defaults/92-h5000m-defaults          first boot
#   /etc/hotplug.d/ieee80211/20-h5000m-defaults   when a radio appears
#
# The hotplug path exists because /etc/config/wireless does NOT ship in the
# image: it is generated by /sbin/wifi config, which the image's own
# /etc/hotplug.d/ieee80211/10-wifi-detect runs on radio hotplug.  A uci-defaults
# script alone can therefore run before any radio section exists and configure
# nothing.  Numbering this script 20 puts it after 10-wifi-detect, so the
# sections are there.
#
# Everything is applied once, guarded by a marker that sysupgrade preserves
# (lib/upgrade/keep.d/h5000m-defaults), so a later image never resets settings
# the owner has changed.

[ -n "${IPKG_INSTROOT:-}" ] && exit 0

# Two independent markers, because the two defaults become possible at
# different times.  A single marker taken when /etc/config/wireless merely EXISTS
# was wrong: the image ships that file empty, so on the first boot the wireless
# pass finds no radio, does nothing, and still burned the marker — after which
# the ieee80211 hotplug that later creates the radios would see the marker and
# skip for ever.  WiFi would never be configured at all.
#
# Separate markers also stop the offload being re-applied on every boot until a
# radio shows up, which would keep overwriting the owner's own changes to it.
MARKER_WIFI='/etc/h5000m-wifi-applied'
MARKER_OFFLOAD='/etc/h5000m-offload-applied'

# The values below are written by scripts/local-build.sh into
# /etc/h5000m-defaults.conf at build time, so the SSID, key, country and the
# offload switches are build inputs rather than constants.  The fallbacks keep
# the script working if that file is ever missing.
H5000M_WIFI_SSID='Higoros-H5000M'
H5000M_WIFI_SSID_2G='Higoros-H5000M-2.4G'
H5000M_WIFI_SSID_5G='Higoros-H5000M-5G'
H5000M_WIFI_KEY='H987654321'
H5000M_WIFI_COUNTRY='CN'
H5000M_WIFI_ENCRYPTION='sae-mixed'
H5000M_WIFI_HTMODE_2G='EHT40'
H5000M_WIFI_HTMODE_5G='EHT160'
H5000M_FLOW_OFFLOAD='1'
H5000M_FLOW_OFFLOAD_HW='1'
# shellcheck source=/dev/null
[ -f /etc/h5000m-defaults.conf ] && . /etc/h5000m-defaults.conf

log() { logger -t h5000m-firstboot "$@" 2>/dev/null || true; }

# --------------------------------------------------------------- wireless ----
# A freshly flashed OpenWrt leaves every radio disabled until someone logs in
# and sets a country, which reads as "WiFi is broken" on a device whose whole
# point is being a 5G CPE.  Turn the radios on with a documented default.
#
# The guard is deliberately conservative: if ANY AP interface already carries a
# non-default SSID the owner has configured wireless, and nothing is touched.
# Returns 0 only when it actually applied the defaults.  "No radio sections yet"
# and "the owner already configured this" both return 1, so the caller does not
# record the work as done.
configure_wireless() {
	[ -f /etc/config/wireless ] || return 1

	local iface radio pkg dev band ssid configured=0 custom=0

	# "Unconfigured" covers BOTH the factory names (OpenWrt ships with
	# OpenWrt/openwrt/empty) AND every name this image can write on an earlier
	# boot: the two per-band names AND the base name they are derived from.
	#
	# The base name is on that list because it is exactly what a half-applied
	# state looks like — the SSID was set before the per-band split existed, or
	# a run stopped between the two interfaces.  Leaving it off the list made
	# the guard read it as "the owner's choice" and freeze the device on the
	# base name for ever, silently: measured on real hardware, the run returned
	# 1, wrote no marker, logged nothing, and the SSIDs never reached
	# -2.4G/-5G.  An owner who sets an SSID that happens to equal the build's
	# base name is far less likely than that state, and the change is visible.
	for iface in $(uci -q show wireless | sed -n 's/^\(wireless\.[^.]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get "${iface}.mode")" = 'ap' ] || continue
		ssid="$(uci -q get "${iface}.ssid" 2>/dev/null || true)"
		if [ -z "$ssid" ] || [ "$ssid" = 'OpenWrt' ] || [ "$ssid" = 'openwrt' ] ||
			[ "$ssid" = "$H5000M_WIFI_SSID" ] ||
			[ "$ssid" = "$H5000M_WIFI_SSID_2G" ] || [ "$ssid" = "$H5000M_WIFI_SSID_5G" ]; then
			configured=1
		else
			custom=1
		fi
	done

	[ "$custom" = '0' ] || return 1
	[ "$configured" = '1' ] || return 1

	for radio in $(uci -q show wireless | sed -n 's/^\(wireless\.[^.]*\)=wifi-device$/\1/p'); do
		band="$(uci -q get "${radio}.band")"
		uci -q set "${radio}.country=${H5000M_WIFI_COUNTRY}"
		uci -q set "${radio}.disabled=0"
		case "$band" in
			2g) uci -q set "${radio}.htmode=${H5000M_WIFI_HTMODE_2G}" ;;
			5g) uci -q set "${radio}.htmode=${H5000M_WIFI_HTMODE_5G}" ;;
		esac
	done

	for iface in $(uci -q show wireless | sed -n 's/^\(wireless\.[^.]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get "${iface}.mode")" = 'ap' ] || continue

		# The band is declared on the radio an interface sits on, reached through
		# its `device`.  That option holds a BARE section name (`radio0`), which
		# `uci get` cannot resolve by itself — it needs the package name, and
		# that is the part of the interface's own name before the first dot.
		# `uci -q get radio0.band` returns EMPTY (measured), which silently sent
		# both bands to the fallback name below instead of failing.
		# Deriving the package beats hardcoding "wireless.": the loop already
		# works on fully-qualified names, and a hardcoded prefix goes stale the
		# day the config moves.
		pkg="${iface%%.*}"
		dev="$(uci -q get "${iface}.device")"
		band=''
		[ -n "$dev" ] && band="$(uci -q get "${pkg}.${dev}.band")"
		case "$band" in
			2g) ssid="${H5000M_WIFI_SSID_2G}" ;;
			5g) ssid="${H5000M_WIFI_SSID_5G}" ;;
			*) ssid="${H5000M_WIFI_SSID}" ;;
		esac

		# bss_transition must stay unset: the official compact wpad variant
		# does not know that hostapd option and rejects the whole AP config.
		uci -q delete "${iface}.bss_transition"
		uci -q set "${iface}.ssid=${ssid}"
		uci -q set "${iface}.encryption=${H5000M_WIFI_ENCRYPTION}"

		# An open network has no key and no management-frame protection: leaving
		# an empty `key` option behind, or asking for PMF on an unencrypted
		# interface, makes hostapd reject the whole AP configuration rather than
		# simply ignoring the extra options.
		if [ "${H5000M_WIFI_ENCRYPTION}" = 'none' ] || [ -z "${H5000M_WIFI_KEY}" ]; then
			uci -q delete "${iface}.key"
			uci -q delete "${iface}.ieee80211w"
		else
			uci -q set "${iface}.key=${H5000M_WIFI_KEY}"
			uci -q set "${iface}.ieee80211w=1"
		fi
		uci -q set "${iface}.ieee80211k=1"
		uci -q set "${iface}.disabled=0"
	done

	uci -q commit wireless
	log "wireless enabled: ssid2g=${H5000M_WIFI_SSID_2G} ssid5g=${H5000M_WIFI_SSID_5G} country=${H5000M_WIFI_COUNTRY} encryption=${H5000M_WIFI_ENCRYPTION}"
	return 0
}

# ------------------------------------------------- flow offload / hardware ---
# This IS the H5000M's hardware acceleration on mainline.
#
# The TurboACC panel shipped by ImmortalWrt and the vendor forks drives the
# out-of-tree MTK "HNAT" driver through /sys/kernel/debug/hnat/.  Mainline has
# no such driver — no mtk_hnat, no turboacc, no shortcut-fe anywhere in the
# tree — so that panel cannot work here at all.
#
# What mainline has instead is mtk_ppe_offload.c: the same PPE hardware, driven
# through the standard netfilter flowtable offload API (flow_cls_offload).  For
# the MT7987 it is fully wired up — mtk_eth_soc's mt7987_data declares
# .offload_version = 2 and .ppe_num = 2, mtk_ppe_init() is called for both PPEs,
# and the required nft_flow_offload / nf_flow_table modules are in the image.
#
# So the feature is present and only switched off: fw4 defaults both
# flow_offloading and flow_offloading_hw to "0", and the stock
# /etc/config/firewall sets neither.  Enabling them is what "turning on
# hardware acceleration" means on this firmware, and the owner can see and
# change both from LuCI (Network -> Firewall -> General Settings).
configure_offload() {
	[ -f /etc/config/firewall ] || return 1

	uci -q get firewall.@defaults[0] >/dev/null 2>&1 || return 1

	uci -q set "firewall.@defaults[0].flow_offloading=${H5000M_FLOW_OFFLOAD}"
	uci -q set "firewall.@defaults[0].flow_offloading_hw=${H5000M_FLOW_OFFLOAD_HW}"
	uci -q commit firewall
	log "flow offload: software=${H5000M_FLOW_OFFLOAD} hardware=${H5000M_FLOW_OFFLOAD_HW}"
	return 0
}

main() {
	# Each default is applied once, independently, and only after it actually
	# took effect.  Re-running is safe either way — the guards inside make both
	# passes no-ops when there is nothing to do or the owner has changed things.
	if [ ! -e "$MARKER_WIFI" ]; then
		if configure_wireless; then
			touch "$MARKER_WIFI"
			chmod 0600 "$MARKER_WIFI"
		fi
	fi

	if [ ! -e "$MARKER_OFFLOAD" ]; then
		if configure_offload; then
			touch "$MARKER_OFFLOAD"
			chmod 0600 "$MARKER_OFFLOAD"
		fi
	fi

	return 0
}

main "$@"
exit 0
